{
  "name": "@credicuenta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --import tsx src/main.ts",
    "lint": "oxlint src test",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.5",
    "decimal.js": "10.6.0",
    "luxon": "3.7.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/luxon": "^3.7.0",
    "@types/node": "26.6.6",
    "@types/supertest": "^6.0.3",
    "oxlint": "latest",
    "prettier": "3.9.10",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

