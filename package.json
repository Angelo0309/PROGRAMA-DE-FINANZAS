{
  "name": "credicuenta",
  "version": "1.0.0",
  "private": true,
  "description": "Control multi-tienda de creditos comerciales",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace @credicuenta/api",
    "dev:web": "npm run dev --workspace @credicuenta/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
